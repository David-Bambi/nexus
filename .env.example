# Configuration variables. This file is NOT loaded automatically: export the
# ones you need in your shell (the service installer forwards NEXUS_HOME if
# it is set when you run it). See README.md, "Configuration".

# Flask signing key. Nothing sensitive is signed today; change it anyway.
NEXUS_SECRET_KEY=dev

# Folder holding data.db, app.log and backups/. Default: ~/.nexus
# NEXUS_HOME=~/.nexus

# Port the server listens on. Default: 8765. The address is always
# 127.0.0.1 and cannot be configured.
# NEXUS_PORT=8765

# Full database URL, overriding NEXUS_HOME's data.db. Handy in development to
# keep a scratch database apart from your real data.
NEXUS_DATABASE_URL=sqlite:///instance/nexus.db
